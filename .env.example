# Canonical site URL (optional on Vercel)
NEXT_PUBLIC_SITE_URL=

# Lunae Advisor via Claude API (optional — rule engine is used otherwise)
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-haiku-5-5

# HMAC secret for signed payment sessions & webhooks (required in production)
PAYMENT_WEBHOOK_SECRET=

# Optional form forwarding (Slack/Zapier/helpdesk webhooks)
CONTACT_WEBHOOK_URL=
WAITLIST_WEBHOOK_URL=
PARTNER_WEBHOOK_URL=
ADVERSE_EVENT_WEBHOOK_URL=
